<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows (not plain net8.0) because it references ProtoVerseApp, which
         is UseWPF and targets net8.0-windows - a test project has to match a
         project reference's TFM family. None of the registry types under test
         actually touch WPF, so this stays a fast, headless test run regardless. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoVerseApp\ProtoVerseApp.csproj" />
  </ItemGroup>

</Project>
