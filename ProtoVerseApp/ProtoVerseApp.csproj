<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProtoVerseApp</RootNamespace>
    <AssemblyName>ProtoVerseApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM Toolkit: gives us ObservableObject / [ObservableProperty] / RelayCommand
         without hand-writing INotifyPropertyChanged boilerplate for every panel. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
