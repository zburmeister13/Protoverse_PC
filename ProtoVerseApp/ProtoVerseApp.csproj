<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProtoVerseApp</RootNamespace>
    <AssemblyName>ProtoVerseApp</AssemblyName>
    <!-- .exe/taskbar/Explorer icon. Window.Icon (MainWindow.xaml) covers the title
         bar/Alt-Tab icon separately - both point at the same file. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM Toolkit: gives us ObservableObject / [ObservableProperty] / RelayCommand
         without hand-writing INotifyPropertyChanged boilerplate for every panel. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- Live trend-line charts for telemetry panels (Accel+Temp, Electronic Load). -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built by tools/build_schematics.ps1 from the KiCad sources. Two per board:
         {CODE}_schematic.pdf is the complete original drawing, border and title block
         intact, opened by the manual's schematic button; {CODE}_circuit.png is a
         cropped raster of just the circuit, shown inline in the manual's Overview.
         Copied beside the .exe rather than embedded as Resources because the PDF is
         handed to the system viewer, which needs a real file path. -->
    <None Include="Assets\Schematics\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

