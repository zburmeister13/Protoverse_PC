<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProtoVerseApp</RootNamespace>
    <AssemblyName>ProtoVerseApp</AssemblyName>
    <!-- .exe/taskbar/Explorer icon. Window.Icon (MainWindow.xaml) covers the title
         bar/Alt-Tab icon separately - both point at the same file. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM Toolkit: gives us ObservableObject / [ObservableProperty] / RelayCommand
         without hand-writing INotifyPropertyChanged boilerplate for every panel. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- Live trend-line charts for telemetry panels (Accel+Temp, Electronic Load). -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schematic PDFs, exported from the KiCad sources via kicad-cli with the
         exclude-drawing-sheet option (no border, no title block) and then cropped to
         the drawn content. Copied beside the .exe rather than embedded as a Resource
         because the manual opens them in the system PDF viewer, which needs a real
         file path. See EVALUATION.md for how they were produced and regenerated. -->
    <None Include="Assets\Schematics\*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
