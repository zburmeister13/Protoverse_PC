<Window x:Class="ProtoVerseApp.Views.CheatSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdl="clr-namespace:ProtoVerseApp.Models.Manual"
        Title="Cheat sheet" Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <!--
        Deliberately its own window rather than a tab or a section: the point is to
        keep it open beside the app while working, after the manual has already been
        read. A cheat sheet you have to navigate to is not a cheat sheet.
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}">
                <Run Text="CHEAT SHEET  ·  MODULE "/><Run Text="{Binding ModuleCode, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding ModuleName}" FontSize="19" FontWeight="Bold" Margin="0,2,0,0"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Tagline}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Border Height="2" HorizontalAlignment="Left" Width="52" Margin="0,10,0,0"
                    Background="{StaticResource AccentGradientBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="This module's manual has no tech notes or key takeaways to summarize yet."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type mdl:CheatSheetNote}">
                            <Border Margin="0,0,0,9" Padding="12,9" CornerRadius="5"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold"
                                               Margin="0,0,0,4" Foreground="{StaticResource AccentTealBrush}"
                                               Visibility="{Binding Title, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Takeaways}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type mdl:CheatSheetTakeaways}">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding SectionTitle}" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,5"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="•  " Foreground="{StaticResource AccentGreenBrush}"/><Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
