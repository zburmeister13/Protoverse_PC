<UserControl x:Class="ProtoVerseApp.Views.RailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoVerseApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RailsViewModel}">

    <!--
        Discrete on/off control of ProtoCore's six switchable supply rails.

        The controls are Buttons, not CheckBoxes, on purpose. A checkbox flips itself
        the instant it's clicked, which would be a local guess about what the hardware
        did - and here that guess is wrong more often than usual, because firmware
        auto-enables parent rails, so one click can legitimately change three rails.
        A button sends a command; the dots redraw from the device's reply.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="ProtoCore voltage rails" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Switch ProtoCore's adjustable supply rails on and off. 3.3 V, 4.5 V and 5 V are always on and cannot be switched - they power the MCU, the module identification bus and this board's own I/O expander."/>

            <!-- Not a footnote. On this hardware revision the power-good lines aren't
                 wired to the MCU, so nothing can confirm a rail actually came up. -->
            <Border Margin="0,12,0,0" Padding="11,9" CornerRadius="5"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource AccentOrangeBrush}" BorderThickness="3,0,0,0">
                <StackPanel>
                    <TextBlock Text="COMMANDED, NOT MEASURED" FontSize="9" FontWeight="Bold"
                               Margin="0,0,0,3" Foreground="{StaticResource AccentOrangeBrush}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="These indicators show what ProtoCore was told to do, not what the rails are actually doing. This board revision doesn't report power-good back to the processor, so a rail can read as on here and be off in reality. If it matters, measure it at the test points."/>
                </StackPanel>
            </Border>

            <!-- Firmware without a Core dispatch path can't answer at all. Saying that
                 plainly is the whole point - "too old" and "nothing happened" are
                 indistinguishable otherwise, and this project has lost a day to
                 exactly that confusion before. -->
            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="5"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource AccentOrangeBrush}" BorderThickness="1"
                    Visibility="{Binding ShowUnsupportedNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="This ProtoCore's firmware doesn't support rail control yet."
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentOrangeBrush}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="The board answered, but told us it doesn't recognize rail commands - so it's running a firmware build from before this feature existed. Nothing is wrong with the connection, and the rest of the app works normally."/>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontStyle="Italic"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Connect to a ProtoCore to control its rails."
                       Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <StackPanel Visibility="{Binding ShowRails, Converter={StaticResource BoolToVisibilityConverter}}">

                <Border Margin="0,14,0,0" Padding="11,9" CornerRadius="5"
                        Background="{StaticResource BgBrush}"
                        BorderBrush="{StaticResource AccentOrangeBrush}" BorderThickness="1"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource AccentOrangeBrush}"/>
                </Border>

                <ItemsControl ItemsSource="{Binding Rails}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="6"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="14" Height="14" Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Stroke="{StaticResource BorderBrush}" StrokeThickness="1"
                                                 Fill="{Binding IsOn, Converter={StaticResource BoolToBrushConverter}}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <TextBlock Grid.Column="2" Text="{Binding VoltageLabel}"
                                                   VerticalAlignment="Center" FontFamily="Consolas"
                                                   Foreground="{StaticResource AccentTealBrush}"/>

                                        <TextBlock Grid.Column="3" Text="{Binding SuppliedBy}" FontSize="11"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <Button Grid.Column="4" Content="{Binding ActionLabel}"
                                                Command="{Binding ToggleCommand}"
                                                MinWidth="92" FontSize="11" Padding="10,5"/>
                                    </Grid>

                                    <!-- Explain before, report after: what this click will
                                         also switch on, or what's blocking a switch-off. -->
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11"
                                               Margin="26,7,0,0" FontStyle="Italic"
                                               Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Re-read from ProtoCore" Command="{Binding RequestRailsCommand}"
                        HorizontalAlignment="Left" FontSize="11" Padding="11,5" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
