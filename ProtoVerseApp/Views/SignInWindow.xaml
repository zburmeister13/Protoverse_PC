<Window x:Class="ProtoVerseApp.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProtoVerse - Sign in" Height="420" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Assets/AppIcon.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}">

    <!--
        Profile picker. Deliberately informal: no password field, because these
        profiles are not a security boundary (see AccountStore) and a fake password box
        would imply protection that doesn't exist. Their job is keeping two people's
        kit tracking apart on a shared PC.
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Who's using ProtoVerse?" FontSize="16" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Profiles keep each person's ProtoMod tracking separate on a shared computer. There's no password - this isn't a security feature."/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Background="{StaticResource SurfaceBrush}">
            <ListBox x:Name="AccountList" Background="Transparent" BorderThickness="0"
                     MouseDoubleClick="OnAccountDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding Modules.Count, Mode=OneWay}"/>
                                    <Run Text="ProtoMods tracked"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Delete" FontSize="10" Padding="8,3"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="OnDeleteAccount" Tag="{Binding Id}"
                                    ToolTip="Deletes this profile and everything it tracked."/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyHint" Grid.Row="1" Margin="12" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextAlignment="Center" FontStyle="Italic" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="No profiles yet. Create one below to start tracking your kit."/>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="New profile" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewNameBox" Grid.Column="0" Margin="0,0,6,0"
                         KeyDown="OnNewNameKeyDown"/>
                <Button Grid.Column="1" Content="Create" Click="OnCreateAccount" MinWidth="70"/>
            </Grid>
            <TextBlock x:Name="ErrorText" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource AccentOrangeBrush}" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" MinWidth="80" Margin="0,0,8,0"
                    Background="{StaticResource SurfaceAltBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"/>
            <Button x:Name="SignInButton" Content="Sign in" Click="OnSignIn" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
