<Window x:Class="ProtoVerseApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProtoVerseApp.ViewModels"
        xmlns:views="clr-namespace:ProtoVerseApp.Views"
        xmlns:conv="clr-namespace:ProtoVerseApp.Converters"
        Title="ProtoVerse" Height="780" Width="1180" MinWidth="900" MinHeight="600"
        Icon="/Assets/AppIcon.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}">

    <!-- Sized 1180x780 on the manuals eval branch: the Slots tab now carries a slot
         navigator, a live panel and a manual with its own table of contents, and at
         the previous 900px the manual body was squeezed to about 500px. -->

    <Window.Resources>

        <!--
            Implicit DataTemplates: WPF picks the right View automatically based on
            the runtime type of each item in Panels. Adding a new ProtoMod panel later
            means adding one more DataTemplate here (and its view model to the Panels
            collection) - the ItemsControl below never needs to change.
        -->
        <DataTemplate DataType="{x:Type vm:BlinkyLedViewModel}">
            <views:BlinkyLedPanel/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccelTempViewModel}">
            <views:AccelTempPanel/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ElectronicLoadViewModel}">
            <views:ElectronicLoadPanel/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmptySlotViewModel}">
            <TextBlock Text="No module detected in this slot." FontStyle="Italic"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UnknownModuleViewModel}">
            <TextBlock Text="This ProtoMod isn't supported by this version of the app yet."
                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand header: orbit mark + wordmark + tagline, with the sign-in control
             pinned to the right. -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Viewbox Width="40" Height="40" Margin="0,0,12,0">
                <Canvas Width="44" Height="44">
                    <Ellipse Canvas.Left="2" Canvas.Top="12" Width="40" Height="20"
                             Stroke="{StaticResource AccentGradientBrush}" StrokeThickness="3" Fill="Transparent"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-25"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="14" Canvas.Top="10" Width="16" Height="16"
                             Stroke="{StaticResource AccentTealBrush}" StrokeThickness="2.5"
                             Fill="{StaticResource BgBrush}"/>
                    <Ellipse Canvas.Left="19" Canvas.Top="15" Width="6" Height="6" Fill="{StaticResource AccentTealBrush}"/>
                    <Ellipse Canvas.Left="17" Canvas.Top="24" Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}"/>
                </Canvas>
            </Viewbox>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ProtoVerse" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Build your universe of electronics." FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

            <!-- Sign-in control. Profiles keep two people's kit tracking apart on a
                 shared PC; they are deliberately not a security feature (no password),
                 which is why this is a name and a button rather than a login form. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Account.DisplayName}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Account.StatusLine}" FontSize="10"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Content="Sign in" Command="{Binding Account.SignInCommand}" MinWidth="70"
                        Visibility="{Binding Account.IsSignedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <Button Content="Switch" Command="{Binding Account.SignInCommand}" MinWidth="64" Margin="0,0,6,0"
                        FontSize="11"
                        Background="{StaticResource SurfaceAltBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Visibility="{Binding Account.IsSignedIn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Sign out" Command="{Binding Account.SignOutCommand}" MinWidth="70"
                        FontSize="11"
                        Visibility="{Binding Account.IsSignedIn, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Connection bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="Simulator mode" IsChecked="{Binding SimulatorMode}"
                      VerticalAlignment="Center" Margin="0,0,20,0"/>
            <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"
                      Width="120" Margin="0,0,8,0" IsEnabled="{Binding CanSelectRealPort}"/>
            <Button Content="Refresh" Command="{Binding RefreshPortsCommand}" MinWidth="70" Margin="0,0,8,0"
                    IsEnabled="{Binding CanSelectRealPort}"/>
            <Button Content="Connect" Command="{Binding ConnectCommand}" MinWidth="80" Margin="0,0,4,0"/>
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" MinWidth="80" Margin="0,0,20,0"
                    IsEnabled="{Binding IsConnected}"/>
            <Button Content="Identify slots" Command="{Binding IdentifySlotsCommand}" MinWidth="100"
                    IsEnabled="{Binding IsConnected}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,0,0,8"
                    Foreground="{StaticResource TextSecondaryBrush}"/>

        <!--
            Main content area, as two top-level tabs:
              Slots   - the live ProtoMod panels for whatever's plugged in right now
                        (unchanged; just moved inside a TabItem)
              Library - the full ProtoMod catalog, owned or not. A discovery surface,
                        so it gets the same real estate as the live slots rather than
                        being squeezed into the collapsed bottom drawer with Traffic
                        Log/Help.
            Uses MainTabControlStyle (not the implicit TabControl style) because this
            one sits in a bounded Height="*" row and its content must scroll inside
            that row - see the comment on that style in App.xaml.
        -->
        <TabControl Grid.Row="3" Style="{StaticResource MainTabControlStyle}">
        <TabItem Header="Slots">
        <!--
            Slot navigator + workspace, replacing the previous stacked-panel list
            (eval branch, 2026-08-31). The left column is a compact map of ProtoCore's
            three physical slots - a colored dot for presence plus what's in it -
            and selecting one opens that module's workspace on the right.

            The workspace keeps the module's live control panel docked above its
            manual, deliberately: reading a step and watching the board respond to it
            is the whole point, so the manual must never take the live state
            full-screen. That constraint is why this isn't simply a third top-level
            tab next to Slots and Library.

            Known limitation, accepted for now: this models one module at a time, so
            an exercise spanning two ProtoMods has no home here yet.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="SLOTS" FontSize="10" FontWeight="Bold"
                           Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row" Padding="10,8" CornerRadius="5"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="BorderBrush"
                                                        Value="{StaticResource TextSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background"
                                                        Value="{StaticResource SurfaceBrush}"/>
                                                <Setter TargetName="row" Property="BorderBrush"
                                                        Value="{StaticResource AccentTealBrush}"/>
                                                <Setter TargetName="row" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Same SlotStateToBrushConverter the stacked
                                         layout used: gray empty, green occupied,
                                         orange present-but-unsupported. -->
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Stroke="{StaticResource BorderBrush}" StrokeThickness="1"
                                             Fill="{Binding SlotState, Converter={StaticResource SlotStateToBrushConverter}}"/>
                                    <TextBlock Text="{Binding SlotName}" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"
                                           FontWeight="SemiBold" Margin="16,2,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Manual available" FontSize="9" Margin="16,2,0,0"
                                           Foreground="{StaticResource AccentTealBrush}"
                                           Visibility="{Binding HasManual, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Workspace for the selected slot: live panel docked top, manual below. -->
            <Grid Grid.Column="1" DataContext="{Binding SelectedSlot}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                        Margin="0,0,0,10" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Stroke="{StaticResource BorderBrush}" StrokeThickness="1"
                                     Fill="{Binding SlotState, Converter={StaticResource SlotStateToBrushConverter}}"/>
                            <TextBlock Text="{Binding SlotName}" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <!-- The module's own panel, unchanged - same view models and
                             DataTemplates the stacked layout used. -->
                        <ContentPresenter Content="{Binding Content}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Background="{StaticResource SurfaceBrush}" Padding="14"
                        Visibility="{Binding HasManual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:ManualView DataContext="{Binding Manual}"/>
                </Border>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Background="{StaticResource SurfaceBrush}" Padding="14"
                        Visibility="{Binding HasManual, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Top" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="No in-app manual for this slot yet. Only the Electronic Load (E05) has one on this evaluation branch."/>
                </Border>
            </Grid>
        </Grid>
        </TabItem>
            <TabItem Header="Library">
                <views:LibraryPanel DataContext="{Binding Library}"/>
            </TabItem>
        </TabControl>

        <!-- Collapsible bottom area: raw traffic log (every frame sent/received, hex +
             decoded) and Help (revision notes + currently supported ProtoMods), as
             tabs sharing one collapsible section. -->
        <Expander Grid.Row="4" Header="Traffic Log &amp; Help" Margin="0,8,0,0"
                  IsExpanded="{Binding TrafficLog.IsExpanded}">
            <TabControl>
                <TabItem Header="Traffic Log">
                    <DockPanel Height="220">
                        <Button DockPanel.Dock="Top" Content="Clear" MinWidth="60" HorizontalAlignment="Right"
                                Margin="0,4,0,4" Command="{Binding TrafficLog.ClearCommand}"/>
                        <DataGrid ItemsSource="{Binding TrafficLog.Entries}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  FontFamily="Consolas" FontSize="11" RowHeight="20">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="90"/>
                                <DataGridTextColumn Header="Dir" Binding="{Binding DirectionLabel}" Width="40"/>
                                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="90"/>
                                <DataGridTextColumn Header="MsgType" Binding="{Binding MsgType}" Width="100"/>
                                <!-- Length and Checksum: the two Raw Frame "blocks" not already
                                     broken out into Module/MsgType/Payload above. STX and ETX
                                     (the other two framing bytes) are constant 0x02/0x03 markers,
                                     explained in the Raw Frame header's tooltip below rather than
                                     given their own always-identical column. -->
                                <DataGridTextColumn Header="Length" Binding="{Binding LengthLabel}" Width="55"/>
                                <DataGridTextColumn Header="Payload" Binding="{Binding PayloadHex}" Width="150"/>
                                <DataGridTextColumn Header="Checksum" Binding="{Binding ChecksumHex}" Width="70"/>
                                <DataGridTextColumn Header="Raw Frame" Binding="{Binding RawHex}" Width="220">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="320"
                                                               Text="Full wire frame, byte-for-byte: STX (0x02) · ProtoModId lo · ProtoModId hi · MsgType · Length · Payload… · Checksum · ETX (0x03). Module/MsgType/Length/Payload/Checksum are already broken out in the columns to the left - this is the exact bytes ProtoCore actually sent or received."/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Help">
                    <views:HelpPanel DataContext="{Binding Help}"/>
                </TabItem>
            </TabControl>
        </Expander>
    </Grid>
</Window>
