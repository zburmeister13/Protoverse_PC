<UserControl x:Class="ProtoVerseApp.Views.AccelTempPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoVerseApp.ViewModels"
             xmlns:oxy="http://oxyplot.org/wpf"
             d:DataContext="{d:DesignInstance Type=vm:AccelTempViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Temp:" Margin="0,0,4,0"/>
            <TextBlock Text="{Binding TemperatureC, StringFormat={}{0:F1} °C}" Width="70" FontWeight="Bold"/>
            <TextBlock Text="Accel X/Y/Z (g):" Margin="16,0,4,0"/>
            <TextBlock Text="{Binding AccelXg, StringFormat={}{0:F2}}" Width="50" FontWeight="Bold"/>
            <TextBlock Text="{Binding AccelYg, StringFormat={}{0:F2}}" Width="50" FontWeight="Bold"/>
            <TextBlock Text="{Binding AccelZg, StringFormat={}{0:F2}}" Width="50" FontWeight="Bold"/>
        </StackPanel>

        <!--
            Live charts, built against Simulator mode's fake telemetry (see
            AccelTempViewModel's doc comment) so this UI doesn't have to wait on
            firmware defining the real payload format: a temperature trend line, an
            X/Y "bubble level" tilt indicator, and a Z fill gauge centered on -1g.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>
            <oxy:PlotView Grid.Column="0" Model="{Binding TempPlotModel}" Height="180" Margin="0,0,6,0"/>
            <oxy:PlotView Grid.Column="1" Model="{Binding XyPlotModel}" Height="180" Margin="6,0,6,0"/>
            <oxy:PlotView Grid.Column="2" Model="{Binding ZGaugeModel}" Height="180" Margin="6,0,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
