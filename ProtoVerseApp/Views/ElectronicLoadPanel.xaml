<UserControl x:Class="ProtoVerseApp.Views.ElectronicLoadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoVerseApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ElectronicLoadViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Current limit (mA):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding CurrentLimitMa, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,8,0"/>
            <Button Content="Apply" Command="{Binding ApplyCurrentLimitCommand}" MinWidth="70" Margin="0,0,20,0"/>
            <TextBlock Text="Commanded:" Margin="0,0,4,0"/>
            <TextBlock Text="{Binding CommandedCurrentMa, StringFormat={}{0} mA}" Width="70" FontWeight="Bold"/>
            <TextBlock Text="Duty:" Margin="12,0,4,0"/>
            <TextBlock Text="{Binding DutyPercent, StringFormat={}{0}%}" Width="50" FontWeight="Bold"/>
        </StackPanel>

        <!--
            This board is open-loop (no ADC feedback), so there's no real measured
            voltage/current to plot - only the commanded current echoed back and
            the PWM duty cycle, shown above as static readouts. See
            ElectronicLoadViewModel's doc comment for why there's deliberately no
            chart here.
        -->
        <TextBlock Text="This module has no current/voltage sensing - values above are commanded, not measured."
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
