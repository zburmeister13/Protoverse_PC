<UserControl x:Class="ProtoVerseApp.Views.BlinkyLedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoVerseApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:BlinkyLedViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <!--
            One physical LED, rendered as a round indicator that's also the click
            target for manual control (checking it sends SetManualLeds - see
            BlinkyLedViewModel). Scoped to this file only, so it can't affect the
            unrelated ToggleButton buried inside App.xaml's ComboBox template.
        -->
        <Style x:Key="LedToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Ellipse x:Name="Dot" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5"
                                 Fill="{StaticResource TextSecondaryBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <Button Content="Toggle"
                    Command="{Binding ToggleCommand}"
                    MinWidth="90" Margin="0,0,12,0"/>
            <Ellipse Width="18" Height="18" Margin="0,0,16,0"
                     Fill="{Binding IsOn, Converter={StaticResource BoolToBrushConverter}}"/>
            <TextBlock Text="Blink rate (ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding BlinkRateMs, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0"/>
            <Button Content="Apply" Command="{Binding ApplyBlinkRateCommand}" MinWidth="70"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Pattern:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding Pattern}"
                      Width="100" Margin="0,0,20,0"/>
            <CheckBox Content="Reverse direction" IsChecked="{Binding Reverse}"
                      VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Mode}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="LEDs:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ToggleButton IsChecked="{Binding Led0On}" Style="{StaticResource LedToggleStyle}"
                          Margin="0,0,8,0" ToolTip="LED 0 - click to set manually"/>
            <ToggleButton IsChecked="{Binding Led1On}" Style="{StaticResource LedToggleStyle}"
                          Margin="0,0,8,0" ToolTip="LED 1 - click to set manually"/>
            <ToggleButton IsChecked="{Binding Led2On}" Style="{StaticResource LedToggleStyle}"
                          Margin="0,0,8,0" ToolTip="LED 2 - click to set manually"/>
            <ToggleButton IsChecked="{Binding Led3On}" Style="{StaticResource LedToggleStyle}"
                          Margin="0,0,16,0" ToolTip="LED 3 - click to set manually"/>
            <TextBlock Text="(animates automatically while Mode is Animated; click any LED to take manual control)"
                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
